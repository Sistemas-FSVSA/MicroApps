<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Selección de Sala | Funeraria San Vicente S.A.</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/agenda/seleccion-sala.css">
  <link rel="icon" href="image/favicon.ico" type="image/x-icon">
</head>

<body>
  <main class="sala-main">
    <div class="sala-wrapper">

      {{!-- Logo --}}
      <div class="sala-logo">
        <img src="/image/logonegro.png" alt="Logo Funeraria San Vicente S.A.">
      </div>

      {{!-- Título --}}
      <div class="sala-header">
        <h2>Reserva de Sala de Juntas</h2>
        <p>Selecciona la sala que deseas reservar</p>
      </div>

      {{!-- Cards de salas --}}
      <div class="sala-cards">

        <div class="sala-card" data-sala-id="1" data-sala-nombre="Sala de Juntas Principal">
          <div class="sala-card-icon">
            <i class="fas fa-building"></i>
          </div>
          <h4>Sala de Juntas Sede Principal</h4>
          <p>Sala principal para reuniones generales y directivas</p>
          <div class="sala-card-footer">
            <span><i class="fas fa-arrow-right"></i> Seleccionar</span>
          </div>
        </div>

        <div class="sala-card" data-sala-id="2" data-sala-nombre="Sala de Juntas Mercadeo">
          <div class="sala-card-icon">
            <i class="fas fa-chart-line"></i>
          </div>
          <h4>Sala de Juntas Mercadeo</h4>
          <p>Sala destinada al equipo de mercadeo y comunicaciones</p>
          <div class="sala-card-footer">
            <span><i class="fas fa-arrow-right"></i> Seleccionar</span>
          </div>
        </div>

        <div class="sala-card" data-sala-id="3" data-sala-nombre="Sala de Juntas Unidad de Duelo">
          <div class="sala-card-icon">
            <i class="fa-solid fa-hand-holding-medical"></i>
          </div>
          <h4>Sala de Juntas Unidad de Duelo</h4>
          <p>Sala para sesiones del área de acompañamiento y duelo</p>
          <div class="sala-card-footer">
            <span><i class="fas fa-arrow-right"></i> Seleccionar</span>
          </div>
        </div>

      </div>

      {{!-- Botón regresar --}}
      <div class="sala-back">
        <a id="btnRegresarInicio" class="btn-regresar-sala">
          <i class="fas fa-arrow-left"></i>
          <strong>Regresar</strong>
        </a>
      </div>

    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  {{!-- ⚠️ Solo cargar config.js y seleccion-sala.js — NUNCA agenda.js aquí --}}
  <script src="/config.js"></script>
  <script src="/controllers/agenda/seleccion-sala.js"></script>
</body>

</html>